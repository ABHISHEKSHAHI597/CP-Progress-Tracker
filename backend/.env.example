# Copy to backend/.env and fill in. See ENV.md for where each value comes from.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cpProgressTracker
JWT_SECRET=<a long random string>

ADMIN_USERNAME=<admin login name>
ADMIN_PASSWORD=<admin login password>

# Production only. The same value goes in the Vercel project, where the /api
# middleware sends it. Leave unset locally. Generate with: openssl rand -hex 32
# PROXY_SECRET=<a long random string>
